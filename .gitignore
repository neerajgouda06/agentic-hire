# Dependencies
node_modules/

# Next.js build output
.next/
out/
build/
dist/

# Environment variables — never commit these
.env
.env.local
.env*.local

# Candidate resume uploads (PII) — keep the directory, ignore contents
server/uploads/*
!server/uploads/.gitkeep

# Workflow logs — keep the directory, ignore contents
server/logs/*
!server/logs/.gitkeep

# Test output
coverage/
playwright-report/
test-results/

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
